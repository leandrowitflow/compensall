# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*-verify/
/out/

# local scratch (lighthouse runs, export scripts)
/tmp/
/lh-*.json
/lh-*.*.json
/lighthouse-*.json

# production
/build

# misc
.DS_Store
figma-*.png
*.pem
/data/claims/
/data/claim-signature-tokens/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
